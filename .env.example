# ENSA Project Manager — environment variables.
# Copy to ".env" for local development (it is gitignored), or give these to the
# production container (docker-compose.prod.yml reads them from .env as well).

# --- Mode ---------------------------------------------------------------------
# dev (default) | prod. In prod the app refuses to start without the REQUIRED values.
ENVIRONMENT=dev

# --- Core (REQUIRED in prod) --------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Hostnames served, comma-separated (e.g. projets.ensa.ma)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public base URL, used in email links (e.g. https://projets.ensa.ma)
SITE_URL=http://localhost:8000
# Extra origins allowed to POST (defaults to SITE_URL when it is https)
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -----------------------------------------------------------------
# Leave unset for SQLite in development. Production: PostgreSQL.
# DATABASE_URL=postgres://ensa:CHANGE_ME@db:5432/ensa

# --- Email --------------------------------------------------------------------
# Development prints emails to the console. Production uses SMTP:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=ENSA Project Manager <noreply@example.com>
# Who receives server error reports, comma-separated
# ADMINS=Responsable technique <tech@example.com>

# --- Files --------------------------------------------------------------------
# MEDIA_ROOT=/data/media                 # avatars, cover images (public)
# PRIVATE_MEDIA_ROOT=/data/private       # deliverables (never served directly)

# --- Security / proxy -----------------------------------------------------------
# Number of reverse proxies in front of the app (Caddy in docker-compose.prod.yml = 1)
# TRUSTED_PROXY_COUNT=1
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_PRELOAD=False
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=15

# --- Misc ---------------------------------------------------------------------
# LOG_LEVEL=INFO
# TIME_ZONE=Africa/Casablanca
# SENTRY_DSN=
